-module(wifi_scanner_config).

-export([get_config/0]).

get_config() ->
    [
        {sta, [
            {ssid, <<"YOUR_SSID">>},
            {psk, <<"YOUR_PASSWORD">>},
            managed,
            {disconnected, fun() -> ok end}
        ]},
        {scan_interval, 5000},  %% ms between scans
        {http_port, 8080}
    ].
